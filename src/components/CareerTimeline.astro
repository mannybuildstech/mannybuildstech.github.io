---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { parse } from 'yaml';

const entries = parse(
	readFileSync(join(process.cwd(), 'src/data/timeline.yaml'), 'utf-8'),
) as { period: string; title: string; employer: string; story: string }[];
const milestones = entries.map(({ period, title, employer, story }) => ({
	period,
	title,
	summary: employer,
	details: story,
}));

---

<section class="career" aria-label="Career history roadmap">
	<div class="career-heading">
		<div class="sound-control">
			<button
				class="sound-toggle"
				type="button"
				aria-label="Mute sound"
				aria-pressed="true"
				title="Sound is enabled; playback may require browser interaction"
			>Mute sound</button>
		</div>
	</div>
	<div class="roadmap">
		<ol class="timeline">
			{
				milestones.map((milestone) => (
					<li>
						<button
							class="milestone"
							type="button"
							aria-label={`${milestone.period}: ${milestone.title}`}
							aria-controls="milestone-detail"
							aria-pressed="false"
							data-title={milestone.title}
							data-summary={milestone.summary}
							data-details={milestone.details}
						>
							<span class="period">{milestone.period}</span>
							<span class="period-reserve" aria-hidden="true">{milestone.period}</span>
							<span class="milestone-title">{milestone.title}</span>
							<span class="milestone-title-reserve" aria-hidden="true">{milestone.title}</span>
						</button>
					</li>
				))
			}
		</ol>
		<aside
			id="milestone-detail"
			class="detail-panel"
			aria-label="Selected milestone details"
			aria-live="polite"
			aria-atomic="true"
			aria-hidden="true"
		>
			{
				milestones.map((milestone) => (
					<div class="detail-reserve-item" aria-hidden="true">
						<h2 class="detail-title">{milestone.title}</h2>
						<p class="detail-summary">{milestone.summary}</p>
						<p class="details-copy">{milestone.details}</p>
					</div>
				))
			}
			<div class="detail-current">
				<h2 class="detail-title"></h2>
				<p class="detail-summary"></p>
				<p class="details-copy"></p>
				<p class="story-prompt"></p>
			</div>
		</aside>
	</div>
</section>

<script>
	const roadmap = document.querySelector('.career');
	const detailPanel = roadmap?.querySelector<HTMLElement>('.detail-panel');
	const detailCurrent = detailPanel?.querySelector<HTMLElement>('.detail-current');
	const detailTitle = detailCurrent?.querySelector('h2');
	const detailSummary = detailCurrent?.querySelector('.detail-summary');
	const detailCopy = detailCurrent?.querySelector('.details-copy');
	const storyPrompt = detailCurrent?.querySelector('.story-prompt');
	const soundToggle = roadmap?.querySelector<HTMLButtonElement>('.sound-toggle');
	const pentatonicNotes = [261.63, 293.66, 329.63, 392, 440, 523.25, 587.33, 659.25, 783.99];
	let audioContext: AudioContext | undefined;
	let soundEnabled = true;
	let audioStatus: 'ready' | 'needs-gesture' | 'unavailable' = 'ready';
	let audioMessage: string | undefined;
	let selectedMilestone: HTMLButtonElement | undefined;
	let transitionTimer: number | undefined;
	let detailVersion = 0;
	let toneRequest = 0;
	let pendingTone: HTMLButtonElement | undefined;
	const activeTones = new Set<{ oscillator: OscillatorNode; gain: GainNode }>();

	const updateSoundControl = () => {
		if (!soundToggle) return;
		const label = !soundEnabled
			? 'Unmute sound'
			: audioStatus === 'needs-gesture'
				? 'Activate sound'
				: audioStatus === 'unavailable'
					? 'Retry sound'
					: 'Mute sound';
		const statusMessage =
			audioMessage ??
			'Sound is on by default; if playback is blocked, click this button or a milestone to activate it.';
		soundToggle.setAttribute('aria-pressed', String(soundEnabled));
		soundToggle.textContent = label;
		soundToggle.setAttribute('aria-label', label === 'Mute sound' ? `${label}; ${statusMessage}` : label);
		soundToggle.title = soundEnabled ? statusMessage : 'Sound is muted';
	};

	const stopActiveTones = () => {
		for (const tone of activeTones) {
			try {
				tone.gain.gain.cancelScheduledValues(audioContext?.currentTime ?? 0);
				tone.gain.gain.setValueAtTime(0, audioContext?.currentTime ?? 0);
				tone.oscillator.stop();
			} catch {
				tone.oscillator.disconnect();
				tone.gain.disconnect();
				activeTones.delete(tone);
			}
		}
	};

	const ensureAudioReady = async (fromUserGesture: boolean) => {
		if (!soundEnabled) return false;
		try {
			if (audioContext?.state === 'closed') audioContext = undefined;
			if (!audioContext) {
				if (!fromUserGesture) {
					audioStatus = 'needs-gesture';
					audioMessage = 'Click or tap Activate sound or a milestone to allow browser audio.';
					updateSoundControl();
					return false;
				}
				if (typeof window.AudioContext !== 'function') {
					throw new Error('Web Audio is not supported by this browser.');
				}
				audioContext = new window.AudioContext();
			}
			if (audioContext.state !== 'running') {
				if (!fromUserGesture) {
					audioStatus = 'needs-gesture';
					audioMessage = 'Click or tap Activate sound or a milestone to allow browser audio.';
					updateSoundControl();
					return false;
				}
				await audioContext.resume();
			}
			if (!soundEnabled) return false;
			if (audioContext.state !== 'running') {
				audioStatus = 'needs-gesture';
				audioMessage = 'The browser is waiting for a click or key press to start audio.';
				updateSoundControl();
				return false;
			}
			audioStatus = 'ready';
			audioMessage = undefined;
			updateSoundControl();
			return true;
		} catch (error) {
			if (!soundEnabled) return false;
			const waitingForGesture =
				audioContext?.state === 'suspended' || audioContext?.state === 'interrupted';
			audioStatus = waitingForGesture ? 'needs-gesture' : 'unavailable';
			audioMessage = waitingForGesture
				? 'The browser is waiting for a click or key press to start audio.'
				: error instanceof Error
					? error.message
					: 'Audio is unavailable.';
			updateSoundControl();
			return false;
		}
	};

	const playMilestoneTone = async (milestone: HTMLButtonElement, fromUserGesture = false) => {
		if (!soundEnabled) return;
		pendingTone = milestone;
		const request = ++toneRequest;
		if (!(await ensureAudioReady(fromUserGesture))) return;
		if (!soundEnabled || request !== toneRequest || selectedMilestone !== milestone || !audioContext) return;

		try {
			const index = Array.from(roadmap!.querySelectorAll('.milestone')).indexOf(milestone);
			const oscillator = audioContext.createOscillator();
			const gain = audioContext.createGain();
			const startAt = audioContext.currentTime;
			const frequency = pentatonicNotes[index % pentatonicNotes.length];
			const tone = { oscillator, gain };
			activeTones.add(tone);

			oscillator.type = 'sine';
			oscillator.frequency.setValueAtTime(frequency, startAt);
			gain.gain.setValueAtTime(0.0001, startAt);
			gain.gain.exponentialRampToValueAtTime(0.025, startAt + 0.025);
			gain.gain.exponentialRampToValueAtTime(0.0001, startAt + 0.19);
			oscillator.connect(gain);
			gain.connect(audioContext.destination);
			oscillator.addEventListener('ended', () => {
				oscillator.disconnect();
				gain.disconnect();
				activeTones.delete(tone);
			}, { once: true });
			oscillator.start(startAt);
			oscillator.stop(startAt + 0.2);
			pendingTone = undefined;
		} catch (error) {
			stopActiveTones();
			audioStatus =
				audioContext?.state === 'suspended' || audioContext?.state === 'interrupted'
					? 'needs-gesture'
					: 'unavailable';
			audioMessage = error instanceof Error ? error.message : 'Audio is unavailable.';
			updateSoundControl();
		}
	};

	const showMilestone = (milestone: HTMLButtonElement, fromUserGesture = false) => {
		if (selectedMilestone === milestone) {
			if (fromUserGesture && soundEnabled && pendingTone === milestone) {
				void playMilestoneTone(milestone, true);
			}
			return;
		}

		const version = ++detailVersion;
		selectedMilestone?.setAttribute('aria-pressed', 'false');
		pendingTone = undefined;
		selectedMilestone = milestone;
		milestone.setAttribute('aria-pressed', 'true');
		void playMilestoneTone(milestone, fromUserGesture);

		if (!detailPanel || !detailTitle || !detailSummary || !detailCopy || !storyPrompt) return;

		const updateDetail = () => {
			if (version !== detailVersion) return;

			detailTitle.textContent = milestone.dataset.title ?? '';
			detailSummary.textContent = milestone.dataset.summary ?? '';
			detailCopy.textContent = milestone.dataset.details ?? '';
			storyPrompt.textContent = milestone.dataset.story ?? '';
			detailPanel.setAttribute('aria-hidden', 'false');
			requestAnimationFrame(() => {
				if (version === detailVersion) detailPanel.classList.add('is-visible');
			});
		};

		if (transitionTimer !== undefined) window.clearTimeout(transitionTimer);
		if (
			(detailPanel.getAttribute('aria-hidden') === 'true' && !detailPanel.classList.contains('is-visible')) ||
			window.matchMedia('(prefers-reduced-motion: reduce)').matches
		) {
			updateDetail();
			return;
		}

		detailPanel.setAttribute('aria-hidden', 'true');
		detailPanel.classList.remove('is-visible');
		transitionTimer = window.setTimeout(updateDetail, 460);
	};

	roadmap?.querySelectorAll<HTMLButtonElement>('.milestone').forEach((milestone) => {
		milestone.addEventListener('pointerenter', (event) => {
			if (event.pointerType === 'mouse' || event.pointerType === 'pen') showMilestone(milestone);
		});
		milestone.addEventListener('focus', () => showMilestone(milestone));
		milestone.addEventListener('click', () => showMilestone(milestone, true));
	});

	soundToggle?.addEventListener('click', async () => {
		if (soundEnabled && audioStatus === 'ready') {
			soundEnabled = false;
			toneRequest += 1;
			pendingTone = undefined;
			stopActiveTones();
			updateSoundControl();
			return;
		}
		soundEnabled = true;
		if (await ensureAudioReady(true) && pendingTone && pendingTone === selectedMilestone) {
			void playMilestoneTone(pendingTone, true);
		}
	});
</script>

<style>
	.career {
		padding: 1.5rem 1.6rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.65rem;
		background: var(--surface);
	}
	.career-heading {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.8rem;
	}
	.sound-control {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}
	.sound-toggle {
		padding: 0.3rem 0.65rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: transparent;
		color: rgb(var(--gray));
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
	}
	.sound-toggle:hover,
	.sound-toggle[aria-pressed='true'] {
		border-color: var(--accent);
		color: rgb(var(--gray-dark));
	}
	.sound-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.roadmap {
		display: grid;
		grid-template-columns: minmax(9rem, 0.8fr) minmax(0, 1.4fr);
		align-items: start;
		gap: 2rem;
	}
	.timeline {
		position: relative;
		margin: 0;
		padding: 0 0 0 0.3rem;
		list-style: none;
	}
	.timeline::before {
		position: absolute;
		top: 1.1rem;
		bottom: 1.1rem;
		left: 0.62rem;
		border-left: 1px solid rgb(var(--gray-light));
		content: '';
	}
	.timeline li {
		position: relative;
		margin: 0;
	}
	.milestone {
		position: relative;
		display: grid;
		grid-template-areas:
			'period'
			'title';
		grid-template-columns: minmax(0, 1fr);
		width: 100%;
		min-height: 3.8rem;
		align-content: center;
		gap: 0.15rem;
		padding: 0.35rem 0.4rem 0.35rem 1.9rem;
		border: 0;
		background: none;
		color: rgb(var(--gray));
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: color 180ms ease;
	}
	.milestone::before {
		position: absolute;
		top: 50%;
		left: 0.12rem;
		width: 0.65rem;
		height: 0.65rem;
		transform: translateY(-50%);
		border: 2px solid rgb(var(--gray));
		border-radius: 50%;
		background: var(--surface);
		content: '';
		transition: border-color 180ms ease, background-color 180ms ease;
	}
	.milestone:hover,
	.milestone[aria-pressed='true'] {
		color: rgb(var(--gray-dark));
	}
	.milestone:hover::before,
	.milestone[aria-pressed='true']::before {
		border-color: #fff;
		background: #fff;
	}
	.milestone:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.period {
		grid-area: period;
		font-size: 0.98rem;
		line-height: 1.3;
		overflow-wrap: anywhere;
		transition: color 180ms ease, font-size 180ms ease, font-weight 180ms ease;
	}
	.period-reserve,
	.milestone-title-reserve {
		grid-column: 1;
		visibility: hidden;
		font-weight: 700;
		overflow-wrap: anywhere;
	}
	.period-reserve {
		grid-area: period;
		font-size: 1.12rem;
		line-height: 1.3;
	}
	.milestone-title {
		grid-area: title;
		display: block;
		overflow-wrap: anywhere;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		font-weight: 400;
		line-height: 1.35;
		transition:
			color 180ms ease,
			font-size 180ms ease,
			font-weight 180ms ease;
	}
	.milestone-title-reserve {
		grid-area: title;
		font-size: 1.08rem;
		line-height: 1.35;
	}
	.milestone:hover .milestone-title,
	.milestone[aria-pressed='true'] .milestone-title {
		color: #fff;
		font-size: 1.08rem;
		font-weight: 700;
	}
	.milestone:hover .period,
	.milestone[aria-pressed='true'] .period {
		color: #fff;
		font-size: 1.12rem;
		font-weight: 700;
	}
	.detail-panel {
		position: sticky;
		top: 1rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-height: 15rem;
		padding: 0.85rem 0.3rem;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.35rem);
		transition:
			opacity 460ms ease,
			transform 460ms ease,
			visibility 0s linear 460ms;
	}
	.detail-reserve-item,
	.detail-current {
		grid-area: 1 / 1;
		align-self: start;
	}
	.detail-reserve-item {
		visibility: hidden;
	}
	.detail-panel.is-visible {
		visibility: visible;
		transform: translateY(0);
		opacity: 1;
		transition-delay: 0s;
	}
	.detail-title {
		margin-bottom: 0.7rem;
		font-size: 1.55rem;
	}
	.detail-summary {
		margin: 0 0 0.8rem;
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		line-height: 1.55;
	}
	.details-copy,
	.story-prompt {
		margin: 0.8rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		line-height: 1.55;
	}
	.story-prompt {
		font-size: 0.78rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.milestone,
		.milestone::before,
		.milestone-title {
			transition: none;
		}
		.detail-panel {
			transition: none;
			transform: none;
		}
		.detail-panel.is-visible {
			opacity: 1;
		}
	}
	@media (max-width: 560px) {
		.career {
			padding: 1.2rem 1rem;
		}
		.roadmap {
			grid-template-columns: minmax(6.7rem, 0.8fr) minmax(0, 1.2fr);
			gap: 0.65rem;
		}
		.milestone {
			min-height: 4.2rem;
			padding-right: 0.3rem;
			padding-left: 1.55rem;
			font-size: 0.76rem;
		}
		.milestone-title {
			font-size: 0.7rem;
		}
		.milestone-title-reserve {
			font-size: 0.94rem;
		}
		.milestone:hover .milestone-title,
		.milestone[aria-pressed='true'] .milestone-title {
			font-size: 0.94rem;
		}
		.period {
			font-size: 0.88rem;
		}
		.period-reserve {
			font-size: 1rem;
		}
		.milestone:hover .period,
		.milestone[aria-pressed='true'] .period {
			font-size: 1rem;
		}
		.milestone::before {
			left: 0.12rem;
			width: 0.55rem;
			height: 0.55rem;
		}
		.detail-panel {
			min-height: 11rem;
		}
		.detail-title {
			font-size: 1.2rem;
		}
		.detail-summary {
			font-size: 0.88rem;
		}
		.details-copy,
		.story-prompt {
			font-size: 0.78rem;
		}
	}
</style>
