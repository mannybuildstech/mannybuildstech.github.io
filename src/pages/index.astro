---
import { getCollection } from 'astro:content';
import CareerTimeline from '../components/CareerTimeline.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="introduction" aria-labelledby="intro-title">
				<div class="welcome">
					<img
						class="profile-picture"
						src="/images/manuel-arredondo.jpeg"
						alt="Manuel Arredondo"
						width="88"
						height="88"
					/>
					<div class="greeting" aria-label="Hi, I'm">
						<span class="greeting-text">Hi </span><span class="welcome-wave" aria-hidden="true">👋</span><span class="greeting-text">, I'm</span>
					</div>
				</div>
				<h1 id="intro-title">Manuel Arredondo</h1>
				<p class="intro-copy">
					In Tech since 2011. I enjoy making software systems reliable and scalable. I'm sharing
					insights from my career, from things like 'how to avoid backend infra meltdowns using
					caching', to 'how to exercise while testing mobile app resilience'
				</p>
				<p class="ai-free-note">
					All of my blog writings are AI free, but I use it heavily for creating visualizations
				</p>
			</section>

			<section class="career-section" aria-labelledby="career-title">
				<h2 id="career-title">Career timeline</h2>
				<CareerTimeline />
			</section>

			<section class="writing" aria-labelledby="writing-title">
				<div class="section-heading">
					<h2 id="writing-title">Writing</h2>
					<a href="/blog/">All posts</a>
				</div>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<time datetime={post.data.pubDate.toISOString()}>
										<FormattedDate date={post.data.pubDate} />
									</time>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-main {
		box-sizing: border-box;
		width: 100%;
		max-width: 900px;
		padding-top: 4rem;
	}
	.introduction {
		margin-bottom: 4rem;
	}
	.introduction h1 {
		margin-bottom: 0.6rem;
	}
	.welcome {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.greeting {
		display: block;
		color: rgb(var(--gray-dark));
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.profile-picture {
		display: inline-block;
		width: 88px;
		height: 88px;
		flex: 0 0 auto;
		margin: 0;
		border-radius: 50%;
		object-fit: cover;
		object-position: center;
		vertical-align: middle;
	}
	.welcome-wave {
		display: inline-block;
		margin-right: 0.2rem;
		font-size: 2rem;
		line-height: 1;
		vertical-align: middle;
	}
	.intro-copy {
		margin-bottom: 0.7rem;
		color: rgb(var(--gray));
	}
	.ai-free-note {
		display: inline-block;
		margin: 0;
		padding: 0.25rem 0.65rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		line-height: 1.5;
	}
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.section-heading h2 {
		font-size: 1.7rem;
	}
	.career-section {
		margin-top: 4rem;
	}
	.writing {
		margin-top: 4rem;
	}
	.writing ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: 1rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.writing a {
		display: block;
		height: 100%;
		padding: 1rem 1.2rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
	}
	.writing a:hover {
		border-color: var(--accent);
	}
	.writing h3 {
		margin-bottom: 0.3rem;
		font-size: 1.2rem;
	}
	.writing p {
		margin: 0 0 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.writing time {
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}
	@media (max-width: 720px) {
		.home-main {
			padding-top: 2rem;
		}
		.introduction {
			margin-bottom: 3rem;
		}
		.profile-picture {
			width: 80px;
			height: 80px;
		}
		.welcome {
			gap: 0.75rem;
		}
		.writing {
			margin-top: 3rem;
		}
	}
</style>
